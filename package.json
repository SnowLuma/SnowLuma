{
  "license": "SEE LICENSE IN LICENSE",
  "name": "snowluma-monorepo",
  "version": "2.0.3",
  "description": "SnowLuma monorepo workspace (pnpm)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @snowluma/core build",
    "build:sdk": "pnpm --filter @snowluma/sdk build",
    "build:webui": "pnpm --filter webui build",
    "build:mcp": "pnpm --filter @snowluma/mcp build",
    "build:all": "pnpm --filter @snowluma/core build:all && pnpm --filter @snowluma/sdk build && pnpm --filter @snowluma/mcp build && pnpm --filter @snowluma/ui build && pnpm --filter webui build",
    "check:release-layout": "node tools/check-release-layout.mjs",
    "dev": "pnpm --filter @snowluma/core dev",
    "dev:mode": "cd dist && cross-env SNOWLUMA_DEV_MODE=1 SNOWLUMA_DEV_WEBUI=1 node index.mjs",
    "dev:web": "pnpm --filter webui dev",
    "test": "pnpm --filter=\"./packages/**\" -r --no-bail --if-present test",
    "test:core": "pnpm --filter @snowluma/core test",
    "test:watch": "pnpm --filter @snowluma/core test:watch",
    "test:common": "pnpm --filter @snowluma/common test",
    "test:all": "pnpm test",
    "test:native": "pnpm --filter=\"./packages/**\" -r --if-present test:native",
    "coverage": "node tools/coverage.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint --config eslint.format.config.ts --fix \"**/*.{ts,tsx,mts,cts}\" && prettier --write \"**/*.{ts,tsx,mts,cts}\"",
    "format:check": "eslint --config eslint.format.config.ts \"**/*.{ts,tsx,mts,cts}\" && prettier --check \"**/*.{ts,tsx,mts,cts}\"",
    "ci": "node tools/ci-check.mjs",
    "start": "node dist/index.mjs",
    "bump": "node tools/bump-version.mjs",
    "release": "node tools/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@vitest/coverage-istanbul": "4.1.4",
    "@vitest/coverage-v8": "^4.1.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jiti": "^2.6.1",
    "prettier": "3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.58.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24",
    "pnpm": "11.25.0"
  }
}
