{
  "license": "SEE LICENSE IN LICENSE",
  "name": "@snowluma/common",
  "version": "2.0.3",
  "private": true,
  "type": "module",
  "description": "SnowLuma shared infrastructure — leaf-package utilities with zero business dependencies. Logger / hex codec / log file transport / log line summariser / packet sender wire-protocol types / runtime config loader. Consumed by @snowluma/protocol, @snowluma/core, and @snowluma/onebot. Per-file subpath exports keep import sites unambiguous and let the bundler tree-shake aggressively (importing `@snowluma/common/hex` doesn't pull in `node:fs` from the logger transport).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./update-source": {
      "types": "./src/update-source.ts",
      "default": "./src/update-source.ts"
    },
    "./semver": {
      "types": "./src/semver.ts",
      "default": "./src/semver.ts"
    },
    "./version": {
      "types": "./src/version.ts",
      "default": "./src/version.ts"
    },
    "./native-path": {
      "types": "./src/native-path.ts",
      "default": "./src/native-path.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./logger": {
      "types": "./src/logger.ts",
      "default": "./src/logger.ts"
    },
    "./coerce": {
      "types": "./src/coerce.ts",
      "default": "./src/coerce.ts"
    },
    "./env": {
      "types": "./src/env.ts",
      "default": "./src/env.ts"
    },
    "./notification-templates": {
      "types": "./src/notification-templates.ts",
      "default": "./src/notification-templates.ts"
    },
    "./single-flight-cache": {
      "types": "./src/single-flight-cache.ts",
      "default": "./src/single-flight-cache.ts"
    },
    "./concurrency": {
      "types": "./src/concurrency.ts",
      "default": "./src/concurrency.ts"
    },
    "./hex": {
      "types": "./src/hex.ts",
      "default": "./src/hex.ts"
    },
    "./json": {
      "types": "./src/json.ts",
      "default": "./src/json.ts"
    },
    "./log-file-transport": {
      "types": "./src/log-file-transport.ts",
      "default": "./src/log-file-transport.ts"
    },
    "./log-sanitize": {
      "types": "./src/log-sanitize.ts",
      "default": "./src/log-sanitize.ts"
    },
    "./log-summary": {
      "types": "./src/log-summary.ts",
      "default": "./src/log-summary.ts"
    },
    "./packet-sender": {
      "types": "./src/packet-sender.ts",
      "default": "./src/packet-sender.ts"
    },
    "./protocol-types": {
      "types": "./src/protocol-types.ts",
      "default": "./src/protocol-types.ts"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "default": "./src/runtime.ts"
    },
    "./uin": {
      "types": "./src/uin.ts",
      "default": "./src/uin.ts"
    },
    "./access-token": {
      "types": "./src/access-token.ts",
      "default": "./src/access-token.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/semver": "7.7.1",
    "typescript": "catalog:",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "semver": "7.7.4"
  },
  "engines": {
    "node": ">=24"
  }
}
