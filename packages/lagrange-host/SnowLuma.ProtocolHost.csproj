<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>snowluma-lagrange-host</AssemblyName>
    <RootNamespace>SnowLuma.ProtocolHost</RootNamespace>
    <LagrangeRoot Condition="'$(LagrangeRoot)' == ''">$(MSBuildThisFileDirectory)..\..\.cache\lagrange-core</LagrangeRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(LagrangeRoot)\Lagrange.Core\Lagrange.Core.csproj" />
  </ItemGroup>
</Project>
